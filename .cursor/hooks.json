{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node _sdds_private/scripts/enforce-guardrails.js",
        "matcher": "Shell|Write|StrReplace|ApplyPatch|RunTerminalCommand|Terminal|execute_command",
        "timeout": 15
      }
    ],
    "postToolUse": [],
    "sessionStart": [
      {
        "command": "node _sdds_private/scripts/inject-session-context.js",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "node _sdds_private/scripts/update-last-session.js",
        "timeout": 20
      }
    ]
  }
}
